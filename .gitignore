# integrate/ is a volatile concept-intake folder, not part of the live skill graph
integrate/

# .react_agent/ is ephemeral session workspace state, not versioned
.react_agent/

# .reference/ holds read-only upstream clones kept as design reference, never imported
.reference/

# Pattern store / vector store artifacts
*.db
*.sqlite
*.sqlite3
learnings.jsonl

# Python artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
test_*.py  # Test files are not versioned

# Todo state (local, not versioned)
.todo/

# Corpus-specific graph analysis runtime outputs (not part of the skill definition)
graph.png
graph_preview.png
graph_report.json
graph_disposition.txt

# OS artifacts
.DS_Store
Thumbs.db
.gstack
# gstack is a vendored clone of github.com/garrytan/gstack (its own git repo)
/gstack/
